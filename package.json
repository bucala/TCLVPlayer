{
  "name": "tclvplayer",
  "version": "1.3.0",
  "private": true,
  "description": "Simple IPTV player for Windows, Android, GoogleTV and web.",
  "main": "native/electron/main.js",
  "scripts": {
    "prepare:web": "node scripts/copy-web.mjs",
    "prepare:vercel": "node scripts/copy-web.mjs --vercel",
    "bridge:package": "node scripts/bridge-package.mjs",
    "bridge:portable": "node scripts/bridge-package.mjs --runtime",
    "web": "npm run prepare:vercel && http-server dist/vercel -a 127.0.0.1 -p 3000 -c-1",
    "proxy": "node scripts/local-proxy.mjs",
    "windows": "npm run prepare:web && electron .",
    "windows:dist": "npm run prepare:web && electron-builder --win nsis portable --publish never",
    "android:init": "node scripts/ensure-android-project.mjs",
    "android:apply-template": "node scripts/apply-android-template.mjs",
    "android:setup": "npm run prepare:web && npm run android:init && npm run android:apply-template && cap sync android",
    "android:sync": "npm run prepare:web && npm run android:init && npm run android:apply-template && cap sync android",
    "android:generate": "node scripts/android-studio.mjs",
    "android:studio": "node scripts/android-studio.mjs --open",
    "android:apk": "node scripts/android-studio.mjs --build",
    "android:open": "cap open android",
    "lint": "eslint .",
    "test": "vitest run",
    "privacy:check": "node scripts/privacy-check.mjs",
    "test:browser": "node tests/browser.cjs",
    "test:bridge-browser": "node tests/bridge-browser.cjs",
    "check": "node scripts/version-check.mjs && npm run privacy:check && npm run lint && npm test"
  },
  "build": {
    "appId": "sk.tclv.player",
    "productName": "TCLVPlayer",
    "files": [
      "dist/web/**/*",
      "assets/icon.png",
      "native/electron/**/*",
      "LICENSE",
      "THIRDPARTY.md",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "artplayer": "^5.2.5",
    "flv.js": "^1.6.2",
    "hls.js": "^1.5.20",
    "jplayer": "^2.9.2",
    "jquery": "^3.7.1",
    "mpegts.js": "^1.8.0",
    "sax": "^1.6.1",
    "undici": "^8.12.2",
    "video.js": "^8.23.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.4.1",
    "http-server": "^14.1.1",
    "playwright": "^1.64.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@electron/get": "^5.1.0"
  },
  "author": "TCLVPlayer contributors"
}
